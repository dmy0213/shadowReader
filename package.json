{
	"name": "shadow-reader",
	"displayName": "shadow reader",
	"description": "摸鱼划水看书，十分隐蔽",
	"version": "0.9.2",
	"publisher": "rainbroadcast",
	"engines": {
		"vscode": "^1.85.0"
	},
	"icon": "images/icon.jpeg",
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"repository": {
		"type": "git",
		"url": "https://github.com/igzhang/shadowReader.git"
	},
	"homepage": "https://github.com/igzhang/shadowReader/blob/main/README.md",
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "shadow reader",
			"properties": {
				"shadowReader.pageSize": {
					"type": "number",
					"default": 50,
					"description": "每次最多显示字数"
				},
				"shadowReader.onlineBookURL": {
					"type": "string",
					"default": "https://www.biqugee6.com",
					"enum": [
						"https://www.caimoge.net",
						"https://www.biqugee6.com"
					],
					"enumDescriptions": [
						"采墨阁",
						"笔趣E"
					],
					"description": "在线书源"
				},
				"shadowReader.hiddenTime": {
					"type": "number",
					"default": 30,
					"description": "自动隐藏时间"
				},
				"shadowReader.bossText": {
					"type": "string",
					"default": "Hello world",
					"description": "老板键模式下显示的文本"
				},
				"shadowReader.trimNextLine": {
					"type": "boolean",
					"default": false,
					"description": "跳过空白和换行（仅对下一页阅读启用）"
				}
			}
		},
		"keybindings": [
			{
				"command": "shadowReader.getNextPage",
				"key": "alt+."
			},
			{
				"command": "shadowReader.getPrevPage",
				"key": "alt+,"
			},
			{
				"command": "shadowReader.showBossInfo",
				"key": "alt+/"
			}
		],
		"commands": [
			{
				"command": "shadowReader.start",
				"title": "开始工作",
				"category": "shadowReader",
				"icon": "$(book)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "shadowReader.start",
					"alt": "markdown.showPreviewToSide",
					"group": "navigation"
				}
			]
		},
		"capabilities" : {
			"hoverProvider" : "true"
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^9.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.9.1",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"eslint": "^10.4.0",
		"glob": "^13.0.6",
		"mocha": "^11.7.6",
		"typescript": "^6.0.3",
		"vscode-test": "^1.6.1"
	},
	"dependencies": {
		"axios": "^1.16.1",
		"chardet": "^2.1.1",
		"cheerio": "^1.2.0",
		"iconv-lite": "^0.7.2"
	}
}
